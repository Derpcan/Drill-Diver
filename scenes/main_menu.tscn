[sub_resource type="GDScript" id="GDScript_5dd4i"]
script/source = "extends Node2D


func _ready() -> void:
	$AnimationPlayer.play(\"Start\")
	$Music.play()
	
	# Create the directories needed to save the file
	DirAccess.make_dir_recursive_absolute(\"user://level_editor/levels\")
	
	#$TestDataPath.text = \"Test Data is found in:\\n\" + OS.get_user_data_dir() + \"/test_data/\"
	#$CopyPath.pressed.connect(_copy_path_to_clipboard)
	
	KeybindSettings.load_user_keybinds()
	AudioSettings.load_audio_settings()
	$\"Control/Level Select\".grab_focus.call_deferred()
	$AnimationPlay.play(\"Scroll\")
	await $AnimationPlayer.animation_finished
	if GameManager.bit_played == false:
		$\"Bit Voice\".play()
		GameManager.bit_played = true
	


func _copy_path_to_clipboard() -> void:
	DisplayServer.clipboard_set(OS.get_user_data_dir() + \"/test_data/\")
	


func _physics_process(delta: float) -> void:
	pass
	#if ghost and ghost.global_position.y > 750:
		#
		#ghost.queue_free()
		#return 
		#ghost = preload(\"res://scenes/ghost/ghost.tscn\").instantiate()
		#ghost.input_log_file_name = \"MainMenuGhost.json\"
		#ghost.input_log_folder_path = \"res://save_info/\"
		#add_child(ghost)
		#
		#ghost.global_position = Vector2(160, 102)
		#ghost.name = \"Player\"
"

