[sub_resource type="GDScript" id="GDScript_5dd4i"]
script/source = "extends Node2D

@onready var ghost:Ghost = $Player

func _ready() -> void:
	$TestDataPath.text = \"Test Data is found in:\\n\" + OS.get_user_data_dir() + \"/test_data/\"
	$CopyPath.pressed.connect(_copy_path_to_clipboard)
	

func _copy_path_to_clipboard() -> void:
	DisplayServer.clipboard_set(OS.get_user_data_dir() + \"/test_data/\")
	


func _physics_process(delta: float) -> void:
	if ghost and ghost.global_position.y > 750:
		
		ghost.queue_free()
		return 
		ghost = preload(\"res://scenes/ghost/ghost.tscn\").instantiate()
		ghost.input_log_file_name = \"MainMenuGhost.json\"
		ghost.input_log_folder_path = \"res://save_info/\"
		add_child(ghost)
		
		ghost.global_position = Vector2(160, 102)
		ghost.name = \"Player\"
"

