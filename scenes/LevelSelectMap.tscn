[sub_resource type="GDScript" id="GDScript_vpmtq"]
script/source = "extends PathFollow2D

@export var move_speed: float = 200.0
var moving := false
var direction := 0  # -1 for left, +1 for right

signal reached_stop(stop_node)

func _process(delta):
	if moving:
		progress += direction * move_speed * delta

		# Update player position:
		get_node(\"../PlayerSprite\").global_position = global_position

		# Set animations:
		var player = get_node(\"../PlayerSprite\")
		if direction != 0:
			player.play(\"run\")
			player.flip_h = direction < 0
		else:
			player.play(\"idle\")
"

