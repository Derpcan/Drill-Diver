[sub_resource type="GDScript" id="GDScript_d4qoj"]
script/source = "extends TextureButton
var mat = material
var focused = false

func _ready():
	self.pressed.connect(_handle_on_press)

func _handle_on_press():
	get_parent().get_parent().get_node(\"ResumeSound\").play()
	SceneManager.pop_scene()
	SceneManager.change_scene(\"res://scenes/main_menu.tscn\")
	
func _on_mouse_entered():
	if focused != true:
		mat.set_shader_parameter(\"useHologram\", true)
		
		focused = true
 
func _on_mouse_exited():
	if focused == true:
		mat.set_shader_parameter(\"useHologram\", false)
		
		focused = false
"

